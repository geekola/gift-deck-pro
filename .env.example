# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only — never prefix with NEXT_PUBLIC_, never commit real values)
# Bypasses RLS. Supabase's API gateway rejects this if sent from a browser,
# but keep it out of client code regardless.
SUPABASE_SECRET_KEY=
